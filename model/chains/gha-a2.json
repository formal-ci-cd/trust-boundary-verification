  "evidence": [
    {
      "kind": "static",
      "source": "results/codeql-actions-model-v2.26.3.csv",
      "claim": "CodeQLの内部表現からproducerのuploadとconsumerのdownloadを抽出した．"
    },
    {
      "kind": "inference",
      "source": ".github/workflows/artifact-a2-safe-consumer.yml",
