{
  "schemaVersion": "0.2.0",
  "scenario": {
    "id": "GHA-A2",
    "platform": "GitHub Actions",
    "description": "PR由来の成果物をworkflow_runが取得するが，信頼済みdigestと一致した場合だけ使用する．",
    "evidenceStatus": "observed"
  },
  "producer": {
    "workflow": {
      "name": "GHA-A Producer - untrusted PR artifact",
      "file": ".github/workflows/artifact-a1-pr-producer.yml",
      "event": "pull_request"
    },
    "operation": {
      "id": "artifact-write:produce-artifact:2",
      "kind": "artifactWriteIntent",
      "jobId": "produce-artifact",
      "stepIndex": 2,
      "name": "trust-boundary-build-output",
      "path": ".research-artifact-input/payload.txt",
      "runId": null
    }
  },
  "consumer": {
    "workflow": {
      "name": "GHA-A2 Verified artifact consumer",
      "file": ".github/workflows/artifact-a2-safe-consumer.yml",
      "event": "workflow_run"
    },
    "operation": {
      "id": "artifact-read:consume-after-verification:0",
      "kind": "artifactReadIntent",
      "jobId": "consume-after-verification",
      "stepIndex": 0,
      "name": "trust-boundary-build-output",
      "path": "${{ runner.temp }}/trust-boundary-artifact",
      "runId": "${{ github.event.workflow_run.id }}"
    }
  },
  "sharedObject": {
    "kind": "artifact",
    "producerRunSelector": "github.run_id",
    "consumerRunSelector": "github.event.workflow_run.id",
    "identityBasis": [
      "producerとconsumerのartifact nameが一致する．",
      "consumerは起動元workflow runのIDをdownload-artifactへ渡す．"
    ],
    "name": "trust-boundary-build-output"
  },
  "facts": {
    "producerUntrusted": "true",
    "writeIntent": "true",
    "writeAuthorized": "true",
    "writeSucceeded": "true",
    "sameObject": "true",
    "readSucceeded": "true",
    "consumerUsesObject": "true",
    "integrityCheckPresent": "true",
    "integrityCheckPassed": "false",
    "privilegedConsumer": "true",
    "hasAuthority": "true"
  },
  "traceMap": {
