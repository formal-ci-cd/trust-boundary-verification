{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formal-ci-cd.github.io/trust-boundary-verification/common-model.schema.json",
  "title": "CI/CD trust boundary common model",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "workflow",
    "sharedStateOperations",
    "runtimeObservations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "source": {
      "type": "object",
      "required": ["type", "file", "staticAnalysisOnly"],
      "properties": {
        "type": {"const": "codeqlTable"},
        "file": {"type": "string"},
        "staticAnalysisOnly": {"const": true}
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["name", "file", "events", "permissions", "jobs", "expressions"],
      "properties": {
        "name": {"type": "string"},
        "file": {"type": "string"},
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/event"}
        },
        "permissions": {
          "type": "array",
          "items": {"$ref": "#/$defs/permission"}
        },
        "jobs": {
          "type": "array",
          "items": {"$ref": "#/$defs/job"}
        },
        "expressions": {
          "type": "array",
          "items": {"$ref": "#/$defs/expression"}
        }
      },
      "additionalProperties": false
    },
    "sharedStateOperations": {
      "type": "array",
      "items": {"$ref": "#/$defs/sharedStateOperation"}
    },
    "runtimeObservations": {
      "type": "array",
      "items": {"$ref": "#/$defs/runtimeObservation"}
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["name", "externallyTriggerable", "privileged"],
      "properties": {
        "name": {"type": "string"},
        "externallyTriggerable": {"type": "boolean"},
        "privileged": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "required": ["jobId", "scope", "access"],
      "properties": {
        "jobId": {"type": ["string", "null"]},
        "scope": {"type": "string"},
        "access": {"type": "string"}
      },
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "required": ["id", "runnerLabels", "steps"],
      "properties": {
        "id": {"type": "string"},
        "runnerLabels": {
          "type": "array",
          "items": {"type": "string"}
        },
        "steps": {
          "type": "array",
          "items": {"$ref": "#/$defs/step"}
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["index", "type"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "type": {"enum": ["uses", "run"]},
        "action": {"type": "string"},
        "version": {"type": "string"},
        "arguments": {"type": "object", "additionalProperties": {"type": "string"}},
        "command": {"type": "string"}
      },
      "additionalProperties": false
    },
    "expression": {
      "type": "object",
      "required": ["raw", "normalized", "line"],
      "properties": {
        "raw": {"type": "string"},
        "normalized": {"type": "string"},
        "line": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "sharedStateOperation": {
      "type": "object",
      "required": ["id", "kind", "jobId", "stepIndex", "key", "path"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["cacheWriteIntent"]},
        "jobId": {"type": "string"},
        "stepIndex": {"type": "integer", "minimum": 0},
        "key": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "runtimeObservation": {
      "type": "object",
      "required": [
        "id",
        "platform",
        "runId",
        "observedAt",
        "platformPolicy",
        "operationResults"
      ],
      "properties": {
        "id": {"type": "string"},
        "platform": {"type": "string"},
        "runId": {"type": "string"},
        "observedAt": {"type": "string", "format": "date"},
        "platformPolicy": {
          "type": "object",
          "required": ["cacheWriteDecision", "effectiveFrom", "basis"],
          "properties": {
            "cacheWriteDecision": {"enum": ["allowed", "denied", "unknown"]},
            "effectiveFrom": {"type": "string", "format": "date"},
            "basis": {"type": "string", "format": "uri"}
          },
          "additionalProperties": false
        },
        "operationResults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["operationId", "outcome", "evidence"],
            "properties": {
              "operationId": {"type": "string"},
              "outcome": {"enum": ["succeeded", "failed", "unknown"]},
              "evidence": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
