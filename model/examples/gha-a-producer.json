  "workflow": {
    "name": "GHA-A Producer - untrusted PR artifact",
    "file": ".github/workflows/artifact-a1-pr-producer.yml",
    "events": [
      {
        "name": "pull_request",
        "externallyTriggerable": true,
        "privileged": false
      }
    ],
    "permissions": [
      {
        "jobId": null,
        "scope": "contents",
        "access": "read"
      }
    ],
    "jobs": [
      {
        "id": "produce-artifact",
        "runnerLabels": [
          "ubuntu-latest"
        ],
        "steps": [
          {
            "index": 0,
            "type": "uses",
            "action": "actions/checkout",
            "version": "11d5960a326750d5838078e36cf38b85af677262",
            "arguments": {
              "persist-credentials": "false"
            }
          },
          {
            "index": 1,
            "type": "run",
            "command": "set -eu"
          },
          {
            "index": 2,
            "type": "uses",
            "action": "actions/upload-artifact",
            "version": "ea165f8d65b6e75b540449e92b4886f43607fa02",
            "arguments": {
              "if-no-files-found": "error",
              "name": "trust-boundary-build-output",
              "path": ".research-artifact-input/payload.txt",
              "retention-days": "1"
            }
          },
          {
            "index": 3,
            "type": "run",
            "command": "printf 'producer_run_id=%s\\n' \"$GITHUB_RUN_ID\""
          }
        ]
      }
    ],
    "expressions": [
      {
        "raw": "${{ github.event.pull_request.number }}",
        "normalized": "github.event.pull_request.number",
        "line": 15
      },
      {
        "raw": "${{ steps.upload-artifact.outputs.artifact-id }}",
