  "workflow": {
    "name": "GHA-C2 Default-branch cache consumer",
    "file": ".github/workflows/cache-c2-default-consumer.yml",
    "events": [
      {
        "name": "workflow_dispatch",
        "externallyTriggerable": true,
        "privileged": true
      }
