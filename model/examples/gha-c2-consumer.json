              "key": "trust-boundary-c2-pr-${{ inputs.pr_number }}-v1",
              "lookup-only": "true",
              "path": ".research-cache-input"
            }
          },
          {
            "index": 1,
            "type": "run",
            "command": "printf 'cache-hit=%s\\n' \"$CACHE_HIT\""
          }
        ]
      }
    ],
    "expressions": [
      {
        "raw": "${{ inputs.pr_number }}",
        "normalized": "inputs.pr_number",
        "line": 28
      },
      {
        "raw": "${{ steps.restore-cache.outputs.cache-hit }}",
        "normalized": "steps.restore-cache.outputs.cache-hit",
        "line": 34
      }
    ]
  },
  "sharedStateOperations": [
    {
      "id": "cache-read:cache-default-consumer:0",
