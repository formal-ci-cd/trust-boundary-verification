{
  "schemaVersion": "0.3.0",
  "scenario": {
    "id": "GHA-A1-AUTO",
    "platform": "GitHub Actions",
    "description": "未信頼PRの成果物を完全性確認なしで模擬公開判断へ使用する危険構成．",
    "evidenceStatus": "observed"
  },
  "producer": {
    "workflow": {
      "name": "GHA-A Producer - untrusted PR artifact",
      "file": ".github/workflows/artifact-a1-pr-producer.yml",
      "event": "pull_request"
    },
    "operation": {
      "id": "artifact-write:produce-artifact:2",
      "kind": "artifactWriteIntent",
      "jobId": "produce-artifact",
      "stepIndex": 2,
      "name": "trust-boundary-build-output",
      "path": ".research-artifact-input/payload.txt",
      "runId": null
    }
  },
  "consumer": {
    "workflow": {
      "name": "GHA-A1 Unverified artifact consumer",
      "file": ".github/workflows/artifact-a1-unsafe-consumer.yml",
      "event": "workflow_run"
    },
    "operation": {
      "id": "artifact-read:consume-without-verification:0",
      "kind": "artifactReadIntent",
      "jobId": "consume-without-verification",
      "stepIndex": 0,
      "name": "trust-boundary-build-output",
      "path": "${{ runner.temp }}/trust-boundary-artifact",
      "runId": "${{ github.event.workflow_run.id }}"
    }
  },
  "sharedObject": {
    "kind": "artifact",
    "producerRunSelector": "github.run_id",
    "consumerRunSelector": "github.event.workflow_run.id",
    "identityBasis": [
      "artifact nameが一致する．",
      "取得側が起動元workflow_runのrun IDを指定する．",
      "workflow_runのworkflows指定が保存側workflow名と一致する．"
    ],
    "name": "trust-boundary-build-output"
  },
