  producer_untrusted := TRUE;
  write_intent := TRUE;
  write_authorized := TRUE;
  write_succeeded := TRUE;
  same_object := TRUE;
  read_succeeded := TRUE;
  consumer_uses_object := TRUE;
  integrity_check_present := TRUE;
  integrity_check_passed := FALSE;
