{
  "cachePolicy": "github-historical-2025",
  "runs": [
    {
      "event": "pull_request_target",
      "activity": "opened",
      "branch": "main",
      "scope": "refs/heads/main",
      "repository": "test/repo",
      "defaultBranch": "refs/heads/main",
      "baseBranch": "refs/heads/main",
      "fork": false,
      "sendWriteTokens": false,
      "defaultBranchWorkflow": true,
      "refType": "branch",
      "runnerOS": "Linux",
      "runnerArch": "X64",
      "cacheVersion": {
        "data": "version1"
      },
      "checkoutFiles": [
        "data"
      ],
      "changedPaths": [
        "src/code.py"
      ],
      "diffComplete": true,
      "tokenAuthenticated": {
        "contents": true
      },
      "id": "writer",
      "checkoutUntrusted": true
    },
    {
      "event": "push",
      "activity": "",
      "branch": "main",
      "scope": "refs/heads/main",
      "repository": "test/repo",
      "defaultBranch": "refs/heads/main",
      "baseBranch": "refs/heads/main",
      "fork": false,
      "sendWriteTokens": false,
      "defaultBranchWorkflow": true,
      "refType": "branch",
      "runnerOS": "Linux",
      "runnerArch": "X64",
      "cacheVersion": {
        "data": "version1"
      },
      "checkoutFiles": [
        "data"
      ],
      "changedPaths": [
        "src/code.py"
      ],
      "diffComplete": true,
      "tokenAuthenticated": {
        "contents": true
      },
      "id": "reader",
      "after": "writer"
    }
  ]
}
