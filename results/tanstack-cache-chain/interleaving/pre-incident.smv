-- One producer run and one consumer run; scheduling is nondeterministic.
-- producer_pc: 0 before PR checkout, 1 checked out, 2 Setup, 3 build, 4 post-job cache save.
-- consumer_pc: 0 before cache restore, 1 restored, 2 code use in OIDC-enabled job.
-- bad: PR-tainted bytes were used by the OIDC-enabled job.
-- EVIDENCE fork-pr-event: pre-incident/.github/workflows/bundle-size.yml:7
-- EVIDENCE untrusted-pr-checkout: pre-incident/.github/workflows/bundle-size.yml:38
-- EVIDENCE producer-external-setup: pre-incident/.github/workflows/bundle-size.yml:43
-- EVIDENCE shared-action-cache: external-setup/.github/setup/action.yml:18
-- EVIDENCE cache-key-expression: external-setup/.github/setup/action.yml:21
-- EVIDENCE untrusted-install: external-setup/.github/setup/action.yml:26
-- EVIDENCE untrusted-build: pre-incident/.github/workflows/bundle-size.yml:46
-- EVIDENCE oidc-authority: pre-incident/.github/workflows/release.yml:17
-- EVIDENCE consumer-external-setup: pre-incident/.github/workflows/release.yml:43
-- EVIDENCE privileged-use-after-restore: pre-incident/.github/workflows/release.yml:46
MODULE main
IVAR
  actor : {producer, consumer};
FROZENVAR
  tainted_cache_saved : boolean;
  same_effective_key : boolean;
  poisoned_entry_restored : boolean;
  poisoned_code_invoked : boolean;
VAR
  producer_pc : 0..4;
  consumer_pc : 0..2;
  cache_tainted : boolean;
  restored_tainted : boolean;
  bad : boolean;
ASSIGN
  init(producer_pc) := 0;
  init(consumer_pc) := 0;
  init(cache_tainted) := FALSE;
  init(restored_tainted) := FALSE;
  init(bad) := FALSE;
  next(producer_pc) := case actor = producer & producer_pc < 4 : producer_pc + 1; TRUE : producer_pc; esac;
  next(consumer_pc) := case actor = consumer & consumer_pc < 2 : consumer_pc + 1; TRUE : consumer_pc; esac;
  next(cache_tainted) := cache_tainted | (actor = producer & producer_pc = 3 & TRUE & tainted_cache_saved);
  next(restored_tainted) := case
    actor = consumer & consumer_pc = 0 : cache_tainted & same_effective_key & poisoned_entry_restored;
    TRUE : restored_tainted;
  esac;
  next(bad) := bad | (actor = consumer & consumer_pc = 1 & restored_tainted & poisoned_code_invoked);
CTLSPEC AG !bad
