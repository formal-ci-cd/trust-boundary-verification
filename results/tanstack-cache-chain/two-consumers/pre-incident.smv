-- One producer and two independently scheduled release runs.
-- All cache outcomes are frozen unknown facts; initial cache is clean.
-- EVIDENCE fork-pr-event: pre-incident/.github/workflows/bundle-size.yml:7
-- EVIDENCE untrusted-pr-checkout: pre-incident/.github/workflows/bundle-size.yml:38
-- EVIDENCE producer-external-setup: pre-incident/.github/workflows/bundle-size.yml:43
-- EVIDENCE shared-action-cache: external-setup/.github/setup/action.yml:18
-- EVIDENCE cache-key-expression: external-setup/.github/setup/action.yml:21
-- EVIDENCE untrusted-install: external-setup/.github/setup/action.yml:26
-- EVIDENCE untrusted-build: pre-incident/.github/workflows/bundle-size.yml:46
-- EVIDENCE oidc-authority: pre-incident/.github/workflows/release.yml:17
-- EVIDENCE consumer-external-setup: pre-incident/.github/workflows/release.yml:43
-- EVIDENCE privileged-use-after-restore: pre-incident/.github/workflows/release.yml:46
MODULE main
IVAR
  actor : {producer, consumer1, consumer2};
FROZENVAR
  save : boolean;
  key1 : boolean;
  restore1 : boolean;
  execute1 : boolean;
  key2 : boolean;
  restore2 : boolean;
  execute2 : boolean;
VAR
  producer_pc : 0..4;
  consumer1_pc : 0..2;
  consumer2_pc : 0..2;
  cache_tainted : boolean;
  restored1 : boolean;
  restored2 : boolean;
  bad1 : boolean;
  bad2 : boolean;
ASSIGN
  init(producer_pc) := 0;
  init(consumer1_pc) := 0;
  init(consumer2_pc) := 0;
  init(cache_tainted) := FALSE;
  init(restored1) := FALSE;
  init(restored2) := FALSE;
  init(bad1) := FALSE;
  init(bad2) := FALSE;
  next(producer_pc) := case actor = producer & producer_pc < 4 : producer_pc + 1; TRUE : producer_pc; esac;
  next(consumer1_pc) := case actor = consumer1 & consumer1_pc < 2 : consumer1_pc + 1; TRUE : consumer1_pc; esac;
  next(consumer2_pc) := case actor = consumer2 & consumer2_pc < 2 : consumer2_pc + 1; TRUE : consumer2_pc; esac;
  next(cache_tainted) := cache_tainted | (actor = producer & producer_pc = 3 & TRUE & save);
  next(restored1) := case
    actor = consumer1 & consumer1_pc = 0 : cache_tainted & key1 & restore1;
    TRUE : restored1;
  esac;
  next(bad1) := bad1 | (actor = consumer1 & consumer1_pc = 1 & restored1 & execute1);
  next(restored2) := case
    actor = consumer2 & consumer2_pc = 0 : cache_tainted & key2 & restore2;
    TRUE : restored2;
  esac;
  next(bad2) := bad2 | (actor = consumer2 & consumer2_pc = 1 & restored2 & execute2);
CTLSPEC AG !(bad1 | bad2)
