-- Synthetic mutable shared-file model; not GitHub artifact replacement semantics
MODULE main
IVAR
  action : 0..5;
VAR
  bad : boolean;
  written_0 : boolean;
  pc_0 : 0..3;
  shared_0 : boolean;
  local_0 : boolean;
  verified_0 : boolean;
  written_1 : boolean;
  pc_1 : 0..3;
  shared_1 : boolean;
  local_1 : boolean;
  verified_1 : boolean;
  written_2 : boolean;
  pc_2 : 0..3;
  shared_2 : boolean;
  local_2 : boolean;
  verified_2 : boolean;
ASSIGN
  init(bad) := FALSE;
  next(bad) := case
    action = 3 & pc_0 = 2 & verified_0 & shared_0 : TRUE;
    action = 4 & pc_1 = 2 & verified_1 & shared_1 : TRUE;
    action = 5 & pc_2 = 2 & verified_2 & shared_2 : TRUE;
    TRUE : bad;
  esac;
  init(written_0) := FALSE;
  init(shared_0) := FALSE;
  init(local_0) := FALSE;
  init(verified_0) := FALSE;
  init(pc_0) := 0;
  next(written_0) := written_0 | (action = 0 & !written_0);
  next(shared_0) := shared_0 | (action = 0 & !written_0);
  next(local_0) := case action = 3 & pc_0 = 0 : shared_0; TRUE : local_0; esac;
  next(verified_0) := case action = 3 & pc_0 = 1 : !shared_0; TRUE : verified_0; esac;
  next(pc_0) := case
    action = 3 & pc_0 = 0 : 1;
    action = 3 & pc_0 = 1 & !shared_0 : 2;
    action = 3 & pc_0 = 1 : 3;
    action = 3 & pc_0 = 2 : 3;
    TRUE : pc_0;
  esac;
  init(written_1) := FALSE;
  init(shared_1) := FALSE;
  init(local_1) := FALSE;
  init(verified_1) := FALSE;
  init(pc_1) := 0;
  next(written_1) := written_1 | (action = 1 & !written_1);
  next(shared_1) := shared_1 | (action = 1 & !written_1);
  next(local_1) := case action = 4 & pc_1 = 0 : shared_1; TRUE : local_1; esac;
  next(verified_1) := case action = 4 & pc_1 = 1 : !shared_1; TRUE : verified_1; esac;
  next(pc_1) := case
    action = 4 & pc_1 = 0 : 1;
    action = 4 & pc_1 = 1 & !shared_1 : 2;
    action = 4 & pc_1 = 1 : 3;
    action = 4 & pc_1 = 2 : 3;
    TRUE : pc_1;
  esac;
  init(written_2) := FALSE;
  init(shared_2) := FALSE;
  init(local_2) := FALSE;
  init(verified_2) := FALSE;
  init(pc_2) := 0;
  next(written_2) := written_2 | (action = 2 & !written_2);
  next(shared_2) := shared_2 | (action = 2 & !written_2);
  next(local_2) := case action = 5 & pc_2 = 0 : shared_2; TRUE : local_2; esac;
  next(verified_2) := case action = 5 & pc_2 = 1 : !shared_2; TRUE : verified_2; esac;
  next(pc_2) := case
    action = 5 & pc_2 = 0 : 1;
    action = 5 & pc_2 = 1 & !shared_2 : 2;
    action = 5 & pc_2 = 1 : 3;
    action = 5 & pc_2 = 2 : 3;
    TRUE : pc_2;
  esac;
CTLSPEC AG !bad
