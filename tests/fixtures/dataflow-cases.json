    {
      "id": "artifact-env-output",
      "workflows": [
        {
          "name": "Flow",
          "on": "pull_request",
          "jobs": {
            "work": {
              "runs-on": "ubuntu-latest",
              "steps": [
                {
                  "uses": "actions/checkout@v4"
                },
                {
                  "uses": "actions/upload-artifact@v4",
                  "with": {
                    "name": "payload",
                    "path": "data"
                  }
                }
              ]
            },
            "reader": {
              "runs-on": "ubuntu-latest",
              "needs": "work",
              "steps": [
                {
                  "uses": "actions/download-artifact@v4",
                  "with": {
                    "name": "payload",
                    "path": "restored"
                  }
                },
                {
                  "run": "set -eu\nrequest=$(tr -d '\\r\\n' < \"$FILE\")\nprintf 'MODE=%s\\n' \"$request\" >> \"$GITHUB_ENV\"",
                  "env": {
                    "FILE": "restored/data"
                  }
                },
                {
                  "run": "echo \"seen=$MODE\" >> \"$GITHUB_OUTPUT\"",
                  "id": "report"
                }
              ]
            }
          }
        }
      ],
      "expectedProperties": {
        "no_transfer": "false",
        "no_use": "false"
      },
      "probeEquals": [
        {
          "job": "reader",
          "step": "report",
          "output": "seen",
          "value": "payload"
        }
      ],
      "probeLabels": [
        {
          "job": "reader",
          "step": "report",
          "output": "seen",
          "origin": true,
          "taint": true,
          "dataDependency": true,
          "controlDependency": false
        }
      ],
      "scenario": {
        "runs": [
          {
            "checkoutFiles": [
              "data"
            ],
            "checkoutValues": {
              "data": [
                "payload\n"
              ]
            }
          }
        ]
      }
    },
