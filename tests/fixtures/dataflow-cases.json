{
  "cases": [
    {
      "id": "env-next-step",
      "workflows": [
        {
          "name": "Flow",
          "on": "workflow_dispatch",
          "jobs": {
            "work": {
              "runs-on": "ubuntu-latest",
              "steps": [
                {
                  "run": "echo \"MODE=runtime\" >> \"$GITHUB_ENV\"",
                  "id": "writer"
                },
                {
                  "run": "echo \"seen=$MODE\" >> \"$GITHUB_OUTPUT\"",
                  "id": "report"
                }
              ]
            }
          },
          "env": {
            "MODE": "workflow"
          }
        }
      ],
      "expectedProperties": {},
      "probeEquals": [
        {
          "job": "work",
          "step": "report",
          "output": "seen",
          "value": "runtime"
        }
      ]
    },
