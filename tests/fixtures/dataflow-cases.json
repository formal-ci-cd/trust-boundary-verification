    {
      "id": "cache-job-output-key",
      "workflows": [
        {
          "name": "Flow",
          "on": "workflow_dispatch",
          "jobs": {
            "work": {
              "runs-on": "ubuntu-latest",
              "steps": [
                {
                  "run": "echo \"key=shared-key\" >> \"$GITHUB_OUTPUT\"",
                  "id": "make"
                }
              ],
              "outputs": {
                "key": "${{ steps.make.outputs.key }}"
              }
            },
            "save": {
              "runs-on": "ubuntu-latest",
              "needs": "work",
              "env": {
                "KEY": "${{ needs.work.outputs.key }}"
              },
              "steps": [
                {
                  "run": "echo 'data' > data"
                },
                {
                  "uses": "actions/cache/save@v4",
                  "with": {
                    "key": "${{ env.KEY }}",
                    "path": "data"
                  }
                }
              ]
            },
            "read": {
              "runs-on": "ubuntu-latest",
              "needs": [
                "work",
                "save"
              ],
              "steps": [
                {
                  "uses": "actions/cache/restore@v4",
                  "with": {
                    "key": "${{ needs.work.outputs.key }}",
                    "path": "data"
                  }
                },
                {
                  "run": "cat data"
                }
              ]
            }
          }
        }
      ],
      "expectedProperties": {
        "no_transfer": "false",
        "no_use": "true"
      },
      "scenario": {
        "cachePolicy": "github-historical-2025",
        "runs": [
          {
            "cacheVersion": {
              "data": "v"
            }
          }
        ]
      },
      "reason": "payload is written as clean literal data; transfer occurs but dependent tainted use does not"
    },
