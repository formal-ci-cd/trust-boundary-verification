    {
      "id": "artifact-control-dependency",
      "workflows": [
        {
          "name": "Flow",
          "on": "pull_request",
          "jobs": {
            "work": {
              "runs-on": "ubuntu-latest",
              "steps": [
                {
                  "uses": "actions/checkout@v4"
                },
                {
                  "uses": "actions/upload-artifact@v4",
                  "with": {
                    "name": "payload",
                    "path": "data"
                  }
                }
              ]
            },
            "reader": {
              "runs-on": "ubuntu-latest",
              "needs": "work",
              "steps": [
                {
                  "uses": "actions/download-artifact@v4",
                  "with": {
                    "name": "payload",
                    "path": "restored"
                  }
                },
                {
                  "run": "set -eu\nrequest=$(tr -d '\\r\\n' < \"$FILE\")\nif [ \"$request\" = \"payload\" ]; then\n  result='accepted'\nelse\n  result='rejected'\nfi\nprintf 'MODE=%s\\n' \"$result\" >> \"$GITHUB_ENV\"",
                  "env": {
                    "FILE": "restored/data"
                  }
                },
                {
                  "run": "echo \"seen=$MODE\" >> \"$GITHUB_OUTPUT\"",
                  "id": "report"
                }
              ]
            }
          }
        }
      ],
      "expectedProperties": {
        "no_transfer": "false",
        "no_use": "false"
      },
      "probeEquals": [
        {
          "job": "reader",
          "step": "report",
          "output": "seen",
          "value": "accepted"
        }
      ],
      "probeLabels": [
        {
          "job": "reader",
          "step": "report",
          "output": "seen",
          "origin": true,
          "taint": true,
          "dataDependency": false,
          "controlDependency": true
        }
      ],
      "scenario": {
        "runs": [
          {
            "checkoutFiles": [
              "data"
            ],
            "checkoutValues": {
              "data": [
                "payload\n"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "job-output-after-failure",
      "workflows": [
        {
          "name": "Outputs",
          "on": "workflow_dispatch",
          "jobs": {
            "work": {
              "runs-on": "ubuntu-latest",
              "outputs": {
                "value": "${{ steps.make.outputs.value }}"
              },
              "steps": [
                {
                  "id": "make",
                  "run": "echo \"value=retained\" >> \"$GITHUB_OUTPUT\""
                },
                {
                  "run": "exit 1"
                }
              ]
            },
            "reader": {
              "runs-on": "ubuntu-latest",
              "needs": "work",
              "if": "always()",
              "steps": [
                {
                  "id": "report",
                  "run": "echo \"seen=${{ needs.work.outputs.value }}\" >> \"$GITHUB_OUTPUT\""
                }
              ]
            }
          }
        }
      ],
      "expectedProperties": {},
      "probeEquals": [
        {
          "job": "reader",
          "step": "report",
          "output": "seen",
          "value": "retained"
        }
      ]
    }
  ]
